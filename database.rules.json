{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && (!root.child('admins').exists() || root.child('admins').child(auth.uid).exists())"
      }
    },
    "settings": {
      "public": {
        ".read": true,
        ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
      }
    },
    "adminConfig": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },
    "bikes": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },
    "availability": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },
    "coupons": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$code": {
        ".read": true,
        ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
      }
    },
    "bookings": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".indexOn": [
        "status",
        "createdAt"
      ],
      "$id": {
        ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
        "payment": {
          "refund": {
            ".validate": "auth != null && root.child('admins').child(auth.uid).exists() && (newData.val() === 'due' || newData.val() === 'done')"
          }
        }
      }
    },
    "tracking": {
      "$code": {
        ".read": true,
        ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
      }
    },
    "messages": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".indexOn": [
        "createdAt"
      ],
      "$id": {
        ".write": "(auth != null && root.child('admins').child(auth.uid).exists()) || (!data.exists() && newData.exists() && newData.hasChildren(['name','email','message','createdAt']) && newData.child('createdAt').val() === now && newData.child('name').isString() && newData.child('name').val().length >= 2 && newData.child('name').val().length <= 80 && newData.child('message').isString() && newData.child('message').val().length >= 5 && newData.child('message').val().length <= 1000 && (!newData.child('phone').exists() || (newData.child('phone').isString() && newData.child('phone').val().length <= 15)) && newData.child('email').isString() && newData.child('email').val().length <= 100 && newData.child('email').val().matches(/^[^@ ]+@[^@ ]+[.][^@ ]+$/) && (!newData.child('seen').exists() || newData.child('seen').val() === false))",
        "name": {
          ".validate": true
        },
        "email": {
          ".validate": true
        },
        "phone": {
          ".validate": true
        },
        "message": {
          ".validate": true
        },
        "seen": {
          ".validate": true
        },
        "createdAt": {
          ".validate": true
        },
        "$other": {
          ".validate": "auth != null && root.child('admins').child(auth.uid).exists()"
        }
      }
    }
  }
}